# Copy this file to `.env` (same directory as docker-compose.apps.yml) and fill in real values.
# Docker Compose auto-loads a `.env` file next to the compose file being run, so once this is in
# place you don't need to `export` these into your shell for every session.
#
# `.env` itself is gitignored — never commit real API keys/secrets. This file is the tracked
# template; keep it in sync whenever docker-compose.apps.yml gains/removes a host-supplied var.

# Required — ai-service fails to parse docker-compose.apps.yml at all without this set (uses
# Compose's mandatory ${VAR:?message} syntax, which hard-fails at parse time for every service in
# the file, not just ai-service — see ai-service's OPENAI_API_KEY line).
OPENAI_API_KEY=sk-your-key-here

# Optional — ai-service only uses this if/when an Anthropic-backed model is selected per-request;
# safe to leave blank for OpenAI-only use.
ANTHROPIC_API_KEY=

# Optional — all have working defaults baked into docker-compose.apps.yml (${VAR:-default}).
# Override here only if you need a non-default value locally.
# FRONTEND_URL=http://localhost:3000
# REDIS_PASSWORD=password
# INTERNAL_API_KEY=dev-internal-api-key-change-me
