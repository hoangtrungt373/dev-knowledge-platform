{
  "realm": "dev-knowledge-platform",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@devknowledge.local",
    "fromDisplayName": "Dev Knowledge Platform",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "Standard authenticated user — every account gets this by default."
      },
      {
        "name": "ADMIN",
        "description": "Administrative access (mirrors the app's own UserRole.ADMIN)."
      },
      {
        "name": "default-roles-dev-knowledge-platform",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": ["USER"]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-dev-knowledge-platform",
    "description": "${role_default-roles}",
    "composite": true,
    "clientRole": false
  },
  "clients": [
    {
      "clientId": "gui",
      "name": "Dev Knowledge Platform SPA",
      "description": "Public SPA client — Authorization Code + PKCE only, no client secret.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:3000/auth/callback"
      ],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "diagnostic-cli",
      "name": "Diagnostic CLI (dev/test only)",
      "description": "Dev/test-only diagnostic client (password grant) for smoke-testing token issuance. Not used by any application code — see docker/keycloak/README.md.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": []
    },
    {
      "clientId": "gui-password-login",
      "name": "Dev Knowledge Platform SPA (Password Grant — learning demo)",
      "description": "Public client for Option A (direct password grant / ROPC) on Login.tsx, kept separate from the 'gui' client so the Authorization-Code+PKCE admin flow's client never carries password-grant capability. Built for learning purposes — see Login.tsx's/authService.ts's own comments; not the recommended pattern used elsewhere in this reactor (see the 'gui' client above).",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": []
    },
    {
      "clientId": "identity-service-admin",
      "name": "identity-service (Keycloak Admin API access)",
      "description": "Confidential, server-to-server client — identity-service uses its service account (manage-users role, see the users[] entry below) to call Keycloak's Admin REST API and create user accounts on registration. Never used by gui; the client secret must only ever live in identity-service's own config.",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "dev-identity-admin-secret-change-me",
      "redirectUris": []
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "enabled": false,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "REPLACE_WITH_GOOGLE_CLIENT_ID",
        "clientSecret": "REPLACE_WITH_GOOGLE_CLIENT_SECRET",
        "defaultScope": "openid profile email",
        "syncMode": "IMPORT"
      }
    },
    {
      "alias": "facebook",
      "providerId": "facebook",
      "enabled": false,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "REPLACE_WITH_FACEBOOK_CLIENT_ID",
        "clientSecret": "REPLACE_WITH_FACEBOOK_CLIENT_SECRET",
        "defaultScope": "email public_profile",
        "syncMode": "IMPORT"
      }
    }
  ],
  "users": [
    {
      "username": "service-account-identity-service-admin",
      "serviceAccountClientId": "identity-service-admin",
      "enabled": true,
      "clientRoles": {
        "realm-management": ["manage-users"]
      }
    },
    {
      "username": "kc-smoke-test@devknowledge.local",
      "email": "kc-smoke-test@devknowledge.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Smoke",
      "lastName": "Test",
      "credentials": [
        {
          "type": "password",
          "value": "smoke-test-password",
          "temporary": false
        }
      ],
      "realmRoles": ["USER", "ADMIN"]
    }
  ]
}
