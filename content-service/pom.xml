<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ttg</groupId>
        <artifactId>dev-knowledge-platform</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>content-service</artifactId>
    <name>Content Service</name>
    <description>Categories, tags, and content items (Q&amp;A, articles) — the knowledge corpus surfaced by the RAG pipeline</description>

    <dependencies>

        <!-- Internal -->
        <dependency>
            <groupId>com.ttg</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ttg</groupId>
            <artifactId>infra</artifactId>
        </dependency>

        <!-- ContentErrorCode implements the common ErrorCode interface and references HttpStatus
             directly in main code (unlike social-service, which never names HttpStatus outside
             tests) — common declares spring-boot-starter-web as optional, so it isn't inherited
             transitively; this module needs it on the compile classpath itself. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Commons CSV — startup data seeding from CSV files (Category, Tag) -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
        </dependency>

        <!-- SnakeYAML — front-matter parsing for Markdown-based seed data (QuestionAnswer);
             version managed by spring-boot-starter-parent's dependencyManagement -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>

        <!-- MapStruct — DTO <-> entity mapping for the REST layer (CategoryMapper, TagMapper,
             ArticleMapper, QuestionAnswerMapper); version + annotation-processor wiring managed
             centrally in the root pom's dependencyManagement / maven-compiler-plugin pluginManagement. -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <!-- Bean validation — @Valid/@NotBlank/@NotNull on request DTOs (CreateArticleRequest,
             etc.) and UpdateQualityScoreRequest. Not inherited transitively anymore now that this
             module is a standalone app (it used to arrive via gateway's own dependency on
             ai-service, which declares this starter). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Security — this module's own filter chain now that it's a standalone app
             (see security/SecurityConfig), same reasoning as task-service's/ecommerce-service's
             pom.xml. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- OAuth2 Resource Server — Keycloak is the identity provider; this service only ever
             verifies bearer tokens against Keycloak's JWKS (issuer-uri auto-discovery), never
             issues them. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- OAuth2 Client — KeycloakJwtAuthenticationConverter/CurrentUserResolver build/read a
             common.dto.CustomOAuth2User (implements OAuth2User) as this app's own Authentication
             principal, genuinely at runtime now (not just @AuthenticationPrincipal type support,
             which is why this is no longer <optional>true</optional> — same change task-service's
             pom.xml made for the same reason). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>

        <!-- PostgreSQL — this module's own datasource connection now that it's a standalone app
             with its own schema (`content`), not sharing gateway's connection. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Actuator — health/info/metrics endpoints, same as gateway/task-service/social-service,
             now that this module is independently deployable. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

    </dependencies>

    <build>
        <!-- Include the Liquibase changelog XML/SQL bundled under src/main/java so they end up on
             the runtime classpath — same shape as identity-service's/task-service's pom.xml.
             This module's own changelog is run via the consolidated services-liquibase job in
             docker-compose.apps.yml (no dedicated content-service-liquibase.yml file exists),
             not on app boot — spring.liquibase.enabled stays false here too. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.xml</include>
                    <include>**/*.sql</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
