<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.ttg</groupId>
    <artifactId>dev-knowledge-platform</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>Dev Knowledge Platform</name>
    <description>Knowledge sharing, interview prep, and AI-powered chatbot platform</description>

    <modules>
        <module>common</module>
        <module>infra</module>
        <module>content-service</module>
        <module>ai-service</module>
        <module>task-service</module>
        <module>social-service</module>
        <module>identity-service</module>
        <module>ecommerce-service</module>
        <module>gateway</module>
    </modules>

    <properties>
        <!-- CI-friendly version (https://maven.apache.org/maven-ci-friendly.html): the single
             source of truth for the reactor's version. Every child module's own <parent><version>
             references this same ${revision} placeholder instead of a literal, so bumping the
             version means editing exactly this one line, not all ten pom.xml files. Maven resolves
             the placeholder via each child's <relativePath> back to this file, which works for how
             this reactor is always built (./mvnw from the repo root, with or without -pl) — it does
             NOT get resolved if a child pom is ever built standalone with no relativePath back to
             this parent (not a scenario this reactor uses today). -->
        <revision>0.0.2-SNAPSHOT</revision>
        <java.version>21</java.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <langchain4j.version>0.33.0</langchain4j.version>
        <pgvector.version>0.1.4</pgvector.version>
        <springdoc.version>2.5.0</springdoc.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <jjwt.version>0.12.3</jjwt.version>
        <minio.version>8.5.10</minio.version>
        <bucket4j.version>8.10.1</bucket4j.version>
        <commons-csv.version>1.11.0</commons-csv.version>
        <!-- ecommerce-service's ProductDescriptionSanitizer — sanitizes admin-authored product
             description HTML (from a TipTap WYSIWYG editor) server-side, before it's ever
             persisted or rendered. -->
        <owasp-html-sanitizer.version>20240325.1</owasp-html-sanitizer.version>
        <!-- ecommerce-service's StripePaymentGateway (Epic 4, Payments) — real Stripe test-mode API
             calls, see that module's own pom.xml comment -->
        <stripe-java.version>33.4.0</stripe-java.version>
        <spring-cloud.version>2023.0.3</spring-cloud.version>
        <!-- Matches the quay.io/keycloak/keycloak:26.0 server image in docker-compose.infra.yml —
             identity-service's KeycloakAdminService uses this to call Keycloak's Admin REST API
             for user registration. -->
        <keycloak-admin-client.version>26.0.0</keycloak-admin-client.version>
    </properties>

    <dependencyManagement>
        <dependencies>

            <!-- ==================== Internal Modules ==================== -->
            <dependency>
                <groupId>com.ttg</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ttg</groupId>
                <artifactId>infra</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ttg</groupId>
                <artifactId>content-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ttg</groupId>
                <artifactId>ai-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ttg</groupId>
                <artifactId>task-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ttg</groupId>
                <artifactId>social-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ttg</groupId>
                <artifactId>identity-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ttg</groupId>
                <artifactId>ecommerce-service</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ==================== BOMs ==================== -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- No explicit testcontainers-bom import: spring-boot-dependencies (this reactor's
                 grandparent POM) already manages every org.testcontainers:* artifact at a version
                 tested against this Spring Boot release — redundant to pin our own. -->
            <!-- Spring Cloud — only gateway uses this today (spring-cloud-starter-gateway-mvc,
                 the servlet/blocking variant of Spring Cloud Gateway, not the original WebFlux one —
                 chosen specifically to match every other module's servlet stack). Imported at the root
                 anyway, same convention already established for langchain4j-bom above (ai-service's own
                 sole consumer). 2023.0.3 (aka Leyton) is the release train compatible with this
                 reactor's Spring Boot 3.2.5 parent. -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ==================== Third-Party ==================== -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pgvector</groupId>
                <artifactId>pgvector</artifactId>
                <version>${pgvector.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- MinIO -->
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>

            <!-- Bucket4j — token-bucket rate limiting -->
            <dependency>
                <groupId>com.bucket4j</groupId>
                <artifactId>bucket4j-core</artifactId>
                <version>${bucket4j.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bucket4j</groupId>
                <artifactId>bucket4j-redis</artifactId>
                <version>${bucket4j.version}</version>
            </dependency>

            <!-- Commons CSV — startup data seeding from CSV files -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-csv</artifactId>
                <version>${commons-csv.version}</version>
            </dependency>

            <!-- OWASP Java HTML Sanitizer — ecommerce-service only, for now (see that module's
                 own pom.xml comment on ProductDescriptionSanitizer) -->
            <dependency>
                <groupId>com.googlecode.owasp-java-html-sanitizer</groupId>
                <artifactId>owasp-java-html-sanitizer</artifactId>
                <version>${owasp-html-sanitizer.version}</version>
            </dependency>

            <!-- Stripe Java SDK — ecommerce-service only, for now (StripePaymentGateway, Epic 4:
                 Payments) -->
            <dependency>
                <groupId>com.stripe</groupId>
                <artifactId>stripe-java</artifactId>
                <version>${stripe-java.version}</version>
            </dependency>

            <!-- JWT Dependencies -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <!-- Shared dependencies inherited by ALL modules -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok-mapstruct-binding</artifactId>
                                <version>${lombok-mapstruct-binding.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
