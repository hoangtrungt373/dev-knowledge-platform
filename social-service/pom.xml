<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ttg</groupId>
        <artifactId>dev-knowledge-platform</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>social-service</artifactId>
    <name>Social Service</name>
    <description>Friend graph, requests, blocking, and (later) chat/groups/messaging</description>

    <dependencies>

        <!-- Internal -->
        <dependency>
            <groupId>com.ttg</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ttg</groupId>
            <artifactId>infra</artifactId>
        </dependency>
        <!-- SocialErrorCode (formerly FriendErrorCode) implements the common ErrorCode interface
             and references HttpStatus directly in main code — common declares
             spring-boot-starter-web as optional, so it isn't inherited transitively; this module
             needs it on the compile classpath itself. Same pattern as content-service's
             ContentErrorCode. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- UserApi's @AuthenticationPrincipal CustomOAuth2User params need spring-security-core.
             Used to arrive transitively via the identity-service dependency (declared there
             non-optionally); declared directly here now that this module no longer depends on
             identity-service — common declares this starter optional=true (annotation/type support
             only), same pattern as ai-service/ecommerce-service/gateway. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- CustomOAuth2User implements OAuth2User (org.springframework.security.oauth2.core.user),
             which lives in spring-security-oauth2-client, not spring-security-core. optional=true —
             type support only, same convention as ai-service's identical dependency (see that
             module's CLAUDE.md); this module never runs its own OAuth2 login flow. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- FriendMapper/MessagingMapper (MapStruct) now live here, moved from api. No <version> —
             centrally managed in the root pom, same as everywhere else this dependency appears;
             the annotation-processor wiring is already global. -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <!-- GroupMessagingController/DmMessagingController (STOMP @MessageMapping controllers,
             moved from api) need spring-messaging's annotations plus SimpMessagingTemplate —
             api's own justification for this dependency ("WebSocket/STOMP — live push for
             group/DM chat") applies here too now that the controllers themselves live here. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

    </dependencies>

</project>
