<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ttg</groupId>
        <artifactId>dev-knowledge-platform</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>social-service</artifactId>
    <name>Social Service</name>
    <description>Friend graph, requests, blocking, and (later) chat/groups/messaging</description>

    <dependencies>

        <!-- Internal -->
        <dependency>
            <groupId>com.ttg</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ttg</groupId>
            <artifactId>infra</artifactId>
        </dependency>
        <!-- SocialErrorCode (formerly FriendErrorCode) implements the common ErrorCode interface
             and references HttpStatus directly in main code — common declares
             spring-boot-starter-web as optional, so it isn't inherited transitively; this module
             needs it on the compile classpath itself. Same pattern as content-service's
             ContentErrorCode. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Security — this module's own filter chain now that it's a standalone app
             (see security/SecurityConfig), same reasoning as identity-service's/ecommerce-service's/
             task-service's pom.xml. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- OAuth2 Resource Server — Keycloak is the identity provider; this service only ever
             verifies bearer tokens against Keycloak's JWKS (issuer-uri auto-discovery), never
             issues them. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- OAuth2 Client — KeycloakJwtAuthenticationConverter/CurrentUserResolver build/read a
             common.dto.CustomOAuth2User (implements OAuth2User) as this app's own Authentication
             principal — no longer just compile-time type support now that this module runs its own
             resource-server filter chain, so declared plainly (not optional=true) like
             task-service's identical dependency. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>

        <!-- PostgreSQL — this module's own datasource connection now that it's a standalone app
             with its own schema (`social`), not sharing gateway's connection. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Actuator — health/info/metrics endpoints, same as gateway/ecommerce-service/
             identity-service/task-service, now that this module is independently deployable. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- FriendMapper/MessagingMapper (MapStruct) now live here, moved from api. No <version> —
             centrally managed in the root pom, same as everywhere else this dependency appears;
             the annotation-processor wiring is already global. -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <!-- GroupMessagingController/DmMessagingController (STOMP @MessageMapping controllers,
             moved from api) need spring-messaging's annotations plus SimpMessagingTemplate. Now
             that this module's own WebSocketConfig/StompAuthChannelInterceptor also live here
             (relocated from gateway), this dependency covers the full WebSocket/STOMP transport,
             not just the message-mapping annotations. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- Testcontainers — real Postgres/MinIO/Keycloak for the STOMP DM integration test, so
             the test exercises the same WebSocketConfig/StompAuthChannelInterceptor/
             KeycloakJwtAuthenticationConverter wiring this module boots in production instead of
             mocking around it. Moved here from gateway's pom.xml alongside the tests themselves —
             no Redis dependency, unlike gateway's original version, since this module has no
             Redis-backed bean of its own. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- dasniko/testcontainers-keycloak — the de facto standard Testcontainers module for
             Keycloak; transitively brings org.keycloak:keycloak-admin-client (compile scope in
             its own POM), used to provision a matching Keycloak user per persistUser() call -->
        <dependency>
            <groupId>com.github.dasniko</groupId>
            <artifactId>testcontainers-keycloak</artifactId>
            <version>3.7.0</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <!-- Include the Liquibase changelog XML/SQL bundled under src/main/java so they end up on
             the runtime classpath — same shape as identity-service's/ecommerce-service's/
             task-service's pom.xml. This module's own changelog is run via a standalone
             social-service-liquibase.yml docker-compose file (spring.liquibase.enabled stays false
             here too), not on app boot. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.xml</include>
                    <include>**/*.sql</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
