<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ttg</groupId>
        <artifactId>dev-knowledge-platform</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ecommerce-service</artifactId>
    <name>E-Commerce Service</name>
    <description>Catalog, cart/checkout, orders/inventory, payments, and reviews/recommendations — study-project e-commerce vertical slice</description>

    <dependencies>

        <!-- Internal -->
        <dependency>
            <groupId>com.ttg</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ttg</groupId>
            <artifactId>infra</artifactId>
        </dependency>

        <!-- EcommerceErrorCode implements the common ErrorCode interface and references HttpStatus
             directly in main code, and api/impl controllers use @RestController/ResponseEntity —
             common declares spring-boot-starter-web as optional, so it isn't inherited
             transitively; this module needs it on the compile classpath itself, same reasoning
             as content-service's pom.xml. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- MapStruct — DTO <-> entity mapping for the REST layer (ProductCategoryMapper,
             ProductMapper); version + annotation-processor wiring managed centrally in the root
             pom's dependencyManagement / maven-compiler-plugin pluginManagement. -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <!-- Spring Security — this module's own filter chain now that it's a standalone app
             (see security/SecurityConfig). common declares this optional (type-support only);
             this module needs the real thing. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- OAuth2 Resource Server — Keycloak is the identity provider; this service only ever
             verifies bearer tokens against Keycloak's JWKS (issuer-uri auto-discovery), never
             issues them. Replaces the old JJWT-based JwtVerifier (manual RSA key loading). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- PostgreSQL — this module's own datasource connection now that it's a standalone app
             with its own database (the `ecommerce` schema), not sharing gateway's connection. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Actuator — health/info/metrics endpoints, same as gateway, now that this module is
             independently deployable and needs its own health check. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- KeycloakJwtAuthenticationConverter builds a common.dto.CustomOAuth2User (implements
             OAuth2User) as this app's own Authentication principal — common declares this starter
             optional (type-support only), so it isn't inherited transitively; needed here on the
             classpath for real, same reasoning content-service's pom documents for the same class. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>

        <!-- Spring Data Redis — Epic 2's cart storage (Redis as primary store, not a cache; see
             docs/user-stories/02-cart-checkout.md's "Key decisions locked for this epic"). No
             custom RedisConfig needed, unlike ai-service's Bucket4j use case (which drops down to
             a raw Lettuce client for a mixed String/byte[] codec) — a plain autoconfigured
             StringRedisTemplate's hash operations are exactly what a variantId->quantity cart
             hash needs. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- OWASP Java HTML Sanitizer — ProductDescriptionSanitizer strips everything but a small
             allowlist (blocks/formatting/links/images/tables) from a product's WYSIWYG-authored
             description HTML before ProductServiceImpl ever persists it. Scoped to this module
             only, not infra — infra's own rule is "needed by two feature modules that can't
             depend on each other" (see infra/CLAUDE.md), and content-service stores long-form
             content as Markdown, not HTML, so there's no second consumer yet. -->
        <dependency>
            <groupId>com.googlecode.owasp-java-html-sanitizer</groupId>
            <artifactId>owasp-java-html-sanitizer</artifactId>
        </dependency>

        <!-- Testcontainers Postgres — ProductSearchViewRepositoryIT is the one test in this
             module that needs a real Postgres (tsvector/pg_trgm/JSONB-containment matching is
             genuine SQL a mock can't verify); same two artifacts social-service's own test suite
             already uses, versions managed by spring-boot-dependencies (no explicit version
             needed, see root pom.xml's own comment on this). -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <!-- Include the Liquibase changelog XML/SQL bundled under src/main/java so they end up
             on the runtime classpath — same reasoning/shape as gateway's pom.xml. This module's
             own Liquibase changelog is run via the consolidated services-liquibase job in
             docker-compose.apps.yml (no dedicated ecommerce-service-liquibase.yml file exists),
             not on app boot — spring.liquibase.enabled stays false here too. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.xml</include>
                    <include>**/*.sql</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
