<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ttg</groupId>
        <artifactId>dev-knowledge-platform</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>ecommerce-service</artifactId>
    <name>E-Commerce Service</name>
    <description>Catalog, cart/checkout, orders/inventory, payments, and reviews/recommendations — study-project e-commerce vertical slice</description>

    <dependencies>

        <!-- Internal -->
        <dependency>
            <groupId>com.ttg</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ttg</groupId>
            <artifactId>infra</artifactId>
        </dependency>

        <!-- EcommerceErrorCode implements the common ErrorCode interface and references HttpStatus
             directly in main code, and api/impl controllers use @RestController/ResponseEntity —
             common declares spring-boot-starter-web as optional, so it isn't inherited
             transitively; this module needs it on the compile classpath itself, same reasoning
             as content-service's pom.xml. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- MapStruct — DTO <-> entity mapping for the REST layer (ProductCategoryMapper,
             ProductMapper); version + annotation-processor wiring managed centrally in the root
             pom's dependencyManagement / maven-compiler-plugin pluginManagement. -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <!-- Spring Security — this module's own filter chain/JWT verification now that it's a
             standalone app (see security/SecurityConfig). common declares this optional
             (type-support only); this module needs the real thing. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- JJWT — JwtVerifier verifies (never issues) tokens signed by identity-service using
             the same shared secret; version managed centrally in the root pom. -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- PostgreSQL — this module's own datasource connection now that it's a standalone app
             with its own database (the `ecommerce` schema), not sharing gateway's connection. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Actuator — health/info/metrics endpoints, same as gateway, now that this module is
             independently deployable and needs its own health check. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- JwtAuthenticationFilter builds a common.dto.CustomOAuth2User (implements OAuth2User)
             as this app's own Authentication principal — common declares this starter optional
             (type-support only), so it isn't inherited transitively; needed here on the classpath
             for real, same reasoning content-service's pom documents for the same class. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>

    </dependencies>

    <build>
        <!-- Include the Liquibase changelog XML/SQL bundled under src/main/java so they end up
             on the runtime classpath — same reasoning/shape as gateway's pom.xml. This module's
             own Liquibase changelog is run via the standalone ecommerce-service-liquibase.yml
             docker-compose file (spring.liquibase.enabled stays false here too), not on app boot. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.xml</include>
                    <include>**/*.sql</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
